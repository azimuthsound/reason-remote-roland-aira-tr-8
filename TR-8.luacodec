function remote_supported_control_surfaces()
	local surfaces =		{
			{ manufacturer="Roland", model="TR-8",
				source="TR-8.lua", picture="TR-8.png", 
				in_ports={{description="In Port"}}, out_ports={{description="Out Port", optional=true}}, 
				has_keyboard=true,
				setup_info_text="Make sure the TR-8 is set to MIDI Channel 10." },
		}	return surfaces
end
